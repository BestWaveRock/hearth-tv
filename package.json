{
  "name": "hearth-tv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hearth TV OS \u2014 a tvOS-inspired television operating system that runs entirely in the browser, driven by a real remote control.",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run typecheck && node tools/test-focus.mjs && node tools/test-reachability.mjs",
    "test:focus": "node tools/test-focus.mjs",
    "test:remote": "node tools/test-remote.mjs",
    "mock:webdav": "node tools/mock-webdav.mjs",
    "db:create": "wrangler d1 create hearth-tv",
    "db:migrate": "node tools/migrate.mjs --remote",
    "db:migrate:local": "node tools/migrate.mjs --local",
    "secret:key": "node -e \"console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))\"",
    "test:reach": "node tools/test-reachability.mjs",
    "build:server": "esbuild server-node/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/hearth.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node dist-server/hearth.mjs",
    "build:all": "npm run build && npm run build:server",
    "test:live": "node tools/test-live-sources.mjs",
    "test:direct": "node tools/test-direct-e2e.mjs",
    "dev:node": "npm run build && npm run build:server && node dist-server/hearth.mjs",
    "app:macos": "./macos/build.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hls.js": "^1.7.1",
    "hono": "^4.13.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
